{
  "name": "courtyard-photo-reconstruction",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix projects/courtyard run build && npm --prefix projects/shunde run build && npm run build:knowledge",
    "test": "npm --prefix projects/panjin-map-tour test && npm --prefix projects/courtyard test && npm --prefix projects/shunde test && npm run test:knowledge",
    "build:knowledge": "npm --prefix projects/knowledge-tower run build",
    "test:knowledge": "npm --prefix projects/knowledge-tower test",
    "dev:knowledge": "npm --prefix projects/knowledge-tower run dev",
    "dev": "python3 -m http.server 8773 --bind 127.0.0.1",
    "check": "npx hyperframes@0.8.24 check",
    "render": "npx hyperframes@0.8.24 render --fps 30 --quality high --browser-gpu --workers 1 --output output/Courtyard3D.mp4"
  },
  "dependencies": {
    "gsap": "3.14.2",
    "three": "0.181.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "puppeteer-core": "25.3.0"
  }
}
