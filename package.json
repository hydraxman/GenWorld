{
  "name": "courtyard-photo-reconstruction",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --target=chrome120 --outfile=assets/scene.js",
    "test": "node --test src/*.test.js",
    "dev": "python3 -m http.server 8768 --bind 127.0.0.1",
    "check": "npx hyperframes@0.8.24 check",
    "render": "npx hyperframes@0.8.24 render --fps 30 --quality high --browser-gpu --workers 1 --output output/Courtyard3D.mp4"
  },
  "dependencies": {
    "gsap": "3.14.2",
    "three": "0.181.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "puppeteer-core": "25.3.0"
  }
}
