{
  "name": "genworld",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "skills:install:3d": "node shared/agent-tools/img2threejs.mjs install",
    "skills:check:3d": "node shared/agent-tools/img2threejs.mjs check",
    "test:agent-tools": "node --test shared/agent-tools/*.test.mjs",
    "build": "npm --prefix projects/courtyard run build && npm --prefix projects/shunde run build && npm run build:knowledge",
    "test": "npm --prefix projects/panjin-map-tour test && npm --prefix projects/courtyard test && npm --prefix projects/shunde test && npm run test:knowledge",
    "build:knowledge": "npm --prefix projects/knowledge-tower run build",
    "build:pages": "node projects/site/scripts/build.mjs",
    "test:pages": "node --test projects/site/tests/*.test.mjs",
    "qa:pages": "node projects/site/scripts/qa.mjs",
    "test:wind": "node --test projects/wind-print/tests/*.test.mjs",
    "test:knowledge": "npm --prefix projects/knowledge-tower test",
    "dev:knowledge": "npm --prefix projects/knowledge-tower run dev",
    "dev": "python3 -m http.server 8773 --bind 127.0.0.1",
    "check": "npm --prefix projects/courtyard-baseline run check",
    "render": "npm --prefix projects/courtyard-baseline run render"
  },
  "dependencies": {
    "gsap": "3.14.2",
    "p5": "1.11.13",
    "polygon-clipping": "0.15.7",
    "three": "0.181.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "puppeteer-core": "25.3.0"
  }
}
