 <node id="13267247605" visible="true" version="1" changeset="173934997" timestamp="2025-10-29T15:13:49Z" user="phlinsia" uid="21973722" lat="40.0013743" lon="116.3231393">
  <tag k="denotation" v="landmark"/>
  <tag k="description" v="清华大学校园内树龄最长的这株古树，是一株约382年的国槐，被人称为“至尊长者”。树高18米，树势高大伟岸、粗壮；树冠完整、均衡，冠幅达15米；胸径1.27米，需三人才能合抱；分枝浑厚，挺拔，立于三教和六教两座现代化建筑间，更显得苍劲端庄，极具承载力。清华的古树，绝大多数都是清代栽种，唯有这棵国槐，长于明代崇祯年间的万泉河东坡上。"/>
  <tag k="diameter" v="1.27 m"/>
  <tag k="diameter_crown" v="15 m"/>
  <tag k="height" v="18 m"/>
  <tag k="historic" v="yes"/>
  <tag k="leaf_cycle" v="deciduous"/>
  <tag k="leaf_type" v="broadleaved"/>
  <tag k="name" v="“至尊长者”国槐"/>
  <tag k="natural" v="tree"/>
  <tag k="start_date" v="1642-01-01"/>
  <tag k="wikidata" v="Q288558"/>
  <tag k="wikipedia" v="zh:槐"/>
 </node>
