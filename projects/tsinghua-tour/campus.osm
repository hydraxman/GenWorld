 <node id="13267247608" visible="true" version="3" changeset="175865835" timestamp="2025-12-12T22:52:04Z" user="phlinsia" uid="21973722" lat="40.0014470" lon="116.3231301">
  <tag k="alt_name_1" v="大庙"/>
  <tag k="alt_name_2" v="白庙"/>
  <tag k="description" v="1830年前后，西柳村的西头新建了一座小庙，有佛殿三间、配殿六间，古槐被圈入庙中，位于佛殿之前。古槐以南种植了两株银杏，在大殿的北侧种植了两株桧柏。光绪十八年（1892年）春，43岁的太监道士刘守智在西柳村古庙的基础上营建永安观。光绪十八年（1892年）春，43岁的太监道士刘守智在西柳村古庙的基础上营建永安观。"/>
  <tag k="historic" v="ruins"/>
  <tag k="historic:civilization" v="imperial_chinese"/>
  <tag k="inscription" v="永安观殿前曾经有一座碑，正面有清光绪二十二年（1896年）刻《永安观宗祠记》，歌颂刘守智修观立祠的功德，背面刻有清宣统二年（1910年）刘守智会同白云观住持、永安观监修和西柳村各位首事人共同签署的一份合同，记有永安观庙产、永安观戒律和向白云观移交管理权等事项。碑现已不存，但碑文被收录在《北京图书馆藏中国历代石刻拓本汇编》中。"/>
  <tag k="name" v="永安观"/>
  <tag k="religion" v="taoist"/>
  <tag k="ruins" v="temple"/>
 </node>
