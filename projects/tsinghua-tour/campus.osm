 <node id="13267247602" visible="true" version="7" changeset="177215156" timestamp="2026-01-14T11:10:56Z" user="mueschel" uid="616774" lat="39.9952585" lon="116.3115873">
  <tag k="description" v="“燕东园”本指上世纪 20 年代美国教会大学燕京大学之东。1952 年之前，“燕东园”又名“东大地”，是燕京大学为自己的教师修建的宿舍（别墅区），一路之隔，稍早创立的清华大学的部分教授也在此居住。"/>
  <tag k="historic" v="yes"/>
  <tag k="name" v="东大地"/>
  <tag k="name:zh-Hant" v="東大地"/>
  <tag k="place" v="neighbourhood"/>
 </node>
